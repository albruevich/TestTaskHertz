<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TestTaskHertz.Mobile.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Grid
        Padding="24"
        RowDefinitions="10,60,60,34,44,48,170,*">
        <Label
            Grid.Row="1"
            FontAttributes="Bold"
            FontSize="28"
            HorizontalTextAlignment="Center"
            Text="Тестове для Герц"/>
        <Button
            x:Name="StartJobButton"
            Grid.Row="2"
            BackgroundColor="#FF2B99ED"
            Clicked="OnTestButtonClicked"
            CornerRadius="10"
            FontAttributes="Bold"
            HeightRequest="52"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            WidthRequest="200"
            Text="Запустити задачу"
            TextColor="White"/>
        <ActivityIndicator
            x:Name="JobActivityIndicator"
            Grid.Row="4"
            Color="#FF2B99ED"
            HeightRequest="28"
            HorizontalOptions="Center"
            IsRunning="False"
            Opacity="0"
            VerticalOptions="Center"
            WidthRequest="28"/>
        <Label
            x:Name="StatusLabel"
            Grid.Row="5"
            FontAttributes="Bold"
            FontSize="18"
            HorizontalTextAlignment="Center"
            IsVisible="False"
            LineBreakMode="WordWrap"
            Text="Status"
            VerticalOptions="Center"/>
        <VerticalStackLayout
            Grid.Row="6"
            Spacing="12"
            VerticalOptions="Start">
            <Label
                x:Name="IdLabel"
                FontSize="9"
                HorizontalTextAlignment="Center"
                IsVisible="False"
                LineBreakMode="WordWrap"
                Text="ID"/>
            <Label
                x:Name="ResultLabel"
                FontSize="13"
                HorizontalTextAlignment="Center"
                IsVisible="False"
                LineBreakMode="WordWrap"
                Text="Result"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
