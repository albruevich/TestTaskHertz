<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TestTaskHertz.Mobile.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Grid
        Padding="24"
        RowDefinitions="*,70,80,90,*">
        <Label
            Grid.Row="1"
            FontAttributes="Bold"
            FontSize="28"
            HorizontalTextAlignment="Center"
            Text="Тестове для Герц"/>
        <Button
            x:Name="StartJobButton"
            Grid.Row="2"
            BackgroundColor="#FF2B99ED"
            Clicked="OnTestButtonClicked"
            CornerRadius="10"
            FontAttributes="Bold"
            HeightRequest="52"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            WidthRequest="200"
            Text="Запустити задачу"
            TextColor="White"/>
        <Label
            x:Name="StatusLabel"
            Grid.Row="3"
            FontSize="18"
            HorizontalTextAlignment="Center"
            IsVisible="False"
            LineBreakMode="WordWrap"
            Text="Status"
            VerticalOptions="Start"/>
    </Grid>
</ContentPage>
