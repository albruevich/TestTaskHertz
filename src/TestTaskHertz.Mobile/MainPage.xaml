<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TestTaskHertz.Mobile.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <VerticalStackLayout
        Padding="24"
        Spacing="40"
        VerticalOptions="Center">
        <Label
            FontAttributes="Bold"
            FontSize="28"
            HorizontalTextAlignment="Center"
            Text="Task for Hertz"/>
        <Button
            x:Name="StartJobButton"
            BackgroundColor="#FF2B99ED"
            Clicked="OnTestButtonClicked"
            CornerRadius="10"
            FontAttributes="Bold"
            HeightRequest="52"
            HorizontalOptions="Center"
            WidthRequest="200"
            Text="Запустити задачу"
            TextColor="White"/>
        <Label
            x:Name="StatusLabel"
            FontSize="18"
            HorizontalTextAlignment="Center"
            IsVisible="False"
            Text="Status"/>
    </VerticalStackLayout>
</ContentPage>
